# Series
msgid "＋ New series"
msgstr "＋ Yeni seri"

msgid "Link book to series"
msgstr "Kitabı seriye bağla"

msgid "New series"
msgstr "Yeni seri"

msgid "Series name (e.g. A Song of Ice and Fire)"
msgstr "Seri adı (örn. Buz ve Ateşin Şarkısı)"

msgid "Create & link"
msgstr "Oluştur ve bağla"

msgid "Series name cannot be empty."
msgstr "Seri adı boş olamaz."

msgid "Linked to series '%1'.\nMerged characters: %2 new added, %3 already in series."
msgstr "Seriye bağlandı: '%1'.\nBirleştirilen karakterler: %2 yeni eklendi, %3 zaten seride vardı."

msgid "Linked to series '%1'.\n%2 characters moved to shared series."
msgstr "Seriye bağlandı: '%1'.\n%2 karakter ortak seriye taşındı."

msgid "Linked to series '%1'.\nLoaded %2 shared characters."
msgstr "Seriye bağlandı: '%1'.\n%2 ortak karakter yüklendi."

msgid "Linked to series '%1'.\nNo characters yet — they will be shared across all books in this series."
msgstr "Seriye bağlandı: '%1'.\nHenüz karakter yok — eklenenler serideki tüm kitaplarda ortak olacak."

msgid "Unlink this book from series '%1'?\n\nThe shared series characters will remain in the series. This book will start with an empty character list."
msgstr "Bu kitabın seri bağlantısı kaldırılsın mı: '%1'?\n\nOrtak karakterler seride kalır. Bu kitap boş bir karakter listesiyle başlar."

msgid "Unlink"
msgstr "Bağlantıyı kaldır"

msgid "Unlinked from series '%1'."
msgstr "Seri bağlantısı kaldırıldı: '%1'."

# Menu
msgid "Character list"
msgstr "Karakter listesi"

msgid "Add character"
msgstr "Karakter ekle"

msgid "Underline names in text"
msgstr "Metinde adların altını çiz"

msgid "thick"
msgstr "kalın"

msgid "thin"
msgstr "ince"

msgid "first mention"
msgstr "ilk geçiş"

msgid "Underline style: %1"
msgstr "Çizgi stili: %1"

msgid "Thick (KOReader underline)"
msgstr "Kalın (KOReader alt çizgisi)"

msgid "Thin, light gray"
msgstr "İnce, açık gri"

msgid "Thin, first mention per page only"
msgstr "İnce, sayfada yalnızca ilk geçiş"

msgid "Underline each character only where it is first mentioned on the page. The other mentions are not underlined but can still be tapped."
msgstr "Her karakterin yalnızca sayfada ilk geçtiği yerin altı çizilir. Diğer geçişler çizilmez ama dokununca yine açılır."

msgid "Link to series"
msgstr "Seriye bağla"

msgid "Match whole words only"
msgstr "Yalnızca tam kelime eşleşsin"

msgid "Underline a name only as a whole word: \"Tom\" matches \"Tom\" and \"Tom's\", not \"Tomorrow\". A suffix after an apostrophe is allowed (\"Berk’in\"). Turn off to also match inside words, e.g. to use a stem as alias."
msgstr "Ad yalnızca tam kelime olarak eşleşir: \"Berk\", \"Berk\" ve \"Berk’in\" ile eşleşir, \"Berkay\" ile eşleşmez. Kesme işaretinden sonraki ek serbesttir. Kapatırsanız kelime içinde de eşleşir; örneğin bir kökü takma ad olarak kullanmak için."

msgid "Export / import"
msgstr "Dışa / içe aktarma"

msgid "Export characters now"
msgstr "Karakterleri şimdi dışa aktar"

msgid "Export characters on book closing"
msgstr "Kitap kapanırken karakterleri dışa aktar"

msgid "Also writes the export file on every automatic save, like KOReader's annotation export."
msgstr "KOReader'ın not dışa aktarması gibi, her otomatik kayıtta da dosyayı yazar."

msgid "Keep all characters on import"
msgstr "İçe aktarırken tüm karakterleri koru"

msgid "When enabled, characters missing from the imported file are kept on this device. When disabled, they are removed if the file is newer than their last change."
msgstr "Açıkken, içe aktarılan dosyada olmayan karakterler bu cihazda korunur. Kapalıyken, dosya karakterin son değişikliğinden yeniyse karakter silinir."

msgid "Export / import folder: %1"
msgstr "Dışa / içe aktarma klasörü: %1"

msgid "not set"
msgstr "seçilmedi"

msgid "Current characters export folder:"
msgstr "Şu anki karakter dışa aktarma klasörü:"

msgid "Delete series '%1'?\n\nThis will permanently remove the shared character file (%2 characters). Books currently linked to this series will lose access to its characters."
msgstr "Seri silinsin mi: '%1'?\n\nOrtak karakter dosyası (%2 karakter) kalıcı olarak silinir. Bu seriye bağlı kitaplar bu karakterlere erişemez."

msgid "Deleted series '%1'."
msgstr "Seri silindi: '%1'."

msgid "Change series name"
msgstr "Seri adını değiştir"

msgid "Unlink from series"
msgstr "Seri bağlantısını kaldır"

msgid "Series: %1\n%2 shared characters"
msgstr "Seri: %1\n%2 ortak karakter"
